---
/** 能力域 chips（首页） */
import { skillDomains } from '../data/skills';
---

<div class="caps">
  {
    skillDomains.map((d) => (
      <a class="chip chip--accent cap" href="/about#skills">
        <span class="cap-title">{d.title}</span>
        <span class="cap-count">{d.skills.length}</span>
      </a>
    ))
  }
</div>

<style>
  .caps {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .cap {
    padding: 10px 18px;
    font-size: 14px;
    transition:
      transform var(--dur) var(--ease),
      border-color var(--dur) ease;
  }

  .cap:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    color: var(--accent);
  }

  .cap-count {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-3);
    margin-left: 2px;
  }
</style>
