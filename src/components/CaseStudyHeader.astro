---
import type { Project } from '../data/projects';
import StatusBadge from './StatusBadge.astro';
import ProjectCover from './ProjectCover.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<header class="cs-header">
  <nav class="cs-breadcrumb" aria-label="面包屑">
    <a href="/projects">项目</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{project.title}</span>
  </nav>

  <div class="cs-grid">
    <div class="cs-info">
      <div class="cs-meta">
        {project.status && <StatusBadge status={project.status} />}
        {project.year && <span class="cs-year">{project.year}</span>}
        <span class="cs-role">{project.role}</span>
      </div>
      <h1>{project.title}</h1>
      {project.titleEn && <p class="cs-en">{project.titleEn}</p>}
      <p class="lead cs-summary">{project.summary}</p>
      <div class="cs-tags">
        {project.tags.map((t) => (
          <span class="chip">{t}</span>
        ))}
      </div>
    </div>
    <div class="cs-cover reveal">
      <ProjectCover variant={project.cover} />
    </div>
  </div>
</header>

<style>
  .cs-breadcrumb {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--fs-small);
    color: var(--text-3);
    margin-bottom: var(--sp-4);
  }

  .cs-breadcrumb a {
    color: var(--text-2);
  }

  .cs-breadcrumb a:hover {
    color: var(--accent);
  }

  .cs-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--sp-5);
    align-items: center;
  }

  .cs-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 18px;
  }

  .cs-year {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--text-2);
  }

  .cs-role {
    font-size: var(--fs-tiny);
    letter-spacing: 0.06em;
    color: var(--accent);
    text-transform: uppercase;
  }

  h1 {
    margin-bottom: 10px;
  }

  .cs-en {
    font-size: 16px;
    color: var(--text-3);
    letter-spacing: 0.02em;
    margin-bottom: 18px;
  }

  .cs-summary {
    max-width: 640px;
    margin-bottom: 22px;
  }

  .cs-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  @media (max-width: 860px) {
    .cs-grid {
      grid-template-columns: 1fr;
    }

    .cs-cover {
      order: -1;
    }
  }
</style>
