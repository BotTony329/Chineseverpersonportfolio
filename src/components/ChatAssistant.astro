---
import CowCat from './CowCat.astro';
import { assistantMeta, quickQuestions } from '../data/ai-knowledge';
---

<div class="chat-root">
  <button class="chat-fab" id="chat-fab" type="button" aria-expanded="false" aria-controls="chat-panel">
    <span class="chat-fab-icon" aria-hidden="true"><CowCat /></span>
    <span class="chat-fab-label">问问我的 AI 助手</span>
  </button>

  <section class="chat-panel" id="chat-panel" role="dialog" aria-modal="false" aria-label={`${assistantMeta.name} · AI 助手`} aria-hidden="true">
    <header class="chat-head">
      <span class="chat-avatar" aria-hidden="true"><CowCat /></span>
      <div class="chat-head-text">
        <div class="chat-title-row">
          <strong class="chat-title">{assistantMeta.name} · AI 助手</strong>
          <span class="chat-mode" id="chat-mode">本地知识库回答</span>
        </div>
        <span class="chat-disclaimer" id="chat-disclaimer">{assistantMeta.disclaimer}</span>
      </div>
      <button class="chat-settings-toggle" id="chat-settings-toggle" type="button" aria-label="AI 设置" aria-expanded="false">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="3" />
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h.01a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51h.01a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v.01a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z" />
        </svg>
      </button>
      <button class="chat-close" id="chat-close" type="button" aria-label="关闭对话">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </header>

    <div class="chat-settings" id="chat-settings">
      <p class="chat-settings-title">Optional AI Provider（默认 DeepSeek）</p>
      <label class="chat-settings-label" for="chat-ai-key">API Key</label>
      <input
        class="chat-settings-input"
        id="chat-ai-key"
        type="password"
        placeholder="sk-…（可选，留空则使用本地知识库）"
        autocomplete="off"
      />
      <label class="chat-settings-label" for="chat-ai-model">Model</label>
      <input class="chat-settings-input" id="chat-ai-model" type="text" placeholder="deepseek-chat" autocomplete="off" />
      <label class="chat-settings-label" for="chat-ai-base">Base URL</label>
      <input
        class="chat-settings-input"
        id="chat-ai-base"
        type="text"
        placeholder="https://api.deepseek.com"
        autocomplete="off"
      />
      <div class="chat-settings-actions">
        <button class="chat-settings-btn chat-settings-btn--primary" id="chat-ai-save" type="button">保存</button>
        <button class="chat-settings-btn" id="chat-ai-clear" type="button">清除</button>
      </div>
      <p class="chat-settings-note">
        Key 仅保存在你的浏览器（localStorage），不会上传到本站。支持任何 OpenAI 兼容接口。
      </p>
    </div>

    <div class="chat-msgs" id="chat-msgs" role="log" aria-live="polite"></div>

    <div class="chat-quick" id="chat-quick" aria-label="快捷问题"></div>

    <form class="chat-form" id="chat-form">
      <label class="sr-only" for="chat-input">输入你的问题</label>
      <input
        class="chat-input"
        id="chat-input"
        type="text"
        placeholder="输入你的问题…"
        autocomplete="off"
        enterkeyhint="send"
      />
      <button class="chat-send" id="chat-send" type="submit" aria-label="发送">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 2 11 13" />
          <path d="M22 2 15 22l-4-9-9-4Z" />
        </svg>
      </button>
    </form>
  </section>
</div>

<script>
  import { initChat } from '../scripts/ai-assistant';
  initChat();
</script>

<style>
  .chat-root {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 120;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 14px;
    padding-bottom: env(safe-area-inset-bottom);
  }

  .chat-fab {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 6px 20px 6px 8px;
    border-radius: var(--radius-pill);
    background: var(--surface-2);
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-card);
    transition:
      transform var(--dur) var(--ease),
      border-color var(--dur) ease;
  }

  .chat-fab:hover {
    transform: translateY(-2px);
    border-color: var(--accent-line);
  }

  .chat-fab-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
  }

  .chat-fab-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .chat-fab-label {
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
  }

  .chat-panel {
    display: flex;
    flex-direction: column;
    width: min(380px, calc(100vw - 32px));
    height: 620px;
    max-height: calc(100vh - 100px);
    border-radius: var(--radius-l);
    border: 1px solid var(--border-strong);
    background: var(--surface);
    box-shadow: var(--shadow-pop);
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transform: translateY(14px) scale(0.98);
    transform-origin: bottom right;
    transition:
      opacity var(--dur) var(--ease),
      transform var(--dur) var(--ease),
      visibility var(--dur);
  }

  .chat-panel.open {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  @supports (height: 1dvh) {
    .chat-panel {
      height: min(620px, 78dvh);
    }
  }

  .chat-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
  }

  .chat-avatar {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: 10px;
    overflow: hidden;
  }

  .chat-avatar :global(svg) {
    width: 100%;
    height: 100%;
  }

  .chat-head-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
    flex: 1;
  }

  .chat-title {
    font-size: 14px;
    color: var(--text);
  }

  .chat-title-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .chat-mode {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.04em;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-strong);
    color: var(--text-2);
  }

  .chat-mode.is-ai {
    color: var(--accent);
    border-color: var(--accent-line);
    background: var(--accent-soft);
  }

  .chat-disclaimer {
    font-size: 11px;
    color: var(--text-3);
  }

  .chat-settings-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-s);
    color: var(--text-3);
    transition:
      color var(--dur-fast) ease,
      background-color var(--dur-fast) ease;
  }

  .chat-settings-toggle:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.06);
  }

  .chat-settings {
    display: none;
    flex-direction: column;
    gap: 8px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
  }

  .chat-settings.open {
    display: flex;
  }

  .chat-settings-title {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--text-2);
    margin-bottom: 2px;
  }

  .chat-settings-label {
    font-size: 11px;
    color: var(--text-3);
    margin-top: 2px;
  }

  .chat-settings-input {
    height: 34px;
    padding: 0 12px;
    border-radius: var(--radius-s);
    border: 1px solid var(--border-strong);
    background: var(--bg);
    color: var(--text);
    font-size: 13px;
    font-family: inherit;
    outline: none;
    transition: border-color var(--dur-fast) ease;
  }

  .chat-settings-input:focus {
    border-color: var(--accent-line);
  }

  .chat-settings-actions {
    display: flex;
    gap: 8px;
    margin-top: 4px;
  }

  .chat-settings-btn {
    font-size: 12.5px;
    color: var(--text-2);
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    transition:
      color var(--dur-fast) ease,
      border-color var(--dur-fast) ease;
  }

  .chat-settings-btn:hover {
    color: var(--accent);
    border-color: var(--accent-line);
  }

  .chat-settings-btn--primary {
    color: var(--accent);
    border-color: var(--accent-line);
  }

  .chat-settings-note {
    font-size: 11px;
    line-height: 1.6;
    color: var(--text-3);
    margin-top: 2px;
  }

  .chat-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-s);
    color: var(--text-3);
    transition:
      color var(--dur-fast) ease,
      background-color var(--dur-fast) ease;
  }

  .chat-close:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.06);
  }

  .chat-msgs {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 18px 16px;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }

  .msg {
    display: flex;
    flex-direction: column;
    max-width: 86%;
  }

  .msg--user {
    align-self: flex-end;
  }

  .msg--assistant {
    align-self: flex-start;
  }

  .bubble {
    padding: 10px 14px;
    border-radius: 14px;
    font-size: 14px;
    line-height: 1.7;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .msg--assistant .bubble {
    background: var(--surface-3);
    color: var(--text);
    border: 1px solid var(--border);
    border-bottom-left-radius: 4px;
  }

  .msg--user .bubble {
    background: var(--accent);
    color: #fff;
    border-bottom-right-radius: 4px;
  }

  .msg-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
    padding-inline: 4px;
  }

  .msg-links a {
    font-size: 13px;
    color: var(--accent);
    font-weight: 500;
  }

  .msg--user .msg-links {
    display: none;
  }

  .typing {
    display: inline-flex;
    gap: 5px;
    padding: 14px 16px;
    border-radius: 14px;
    background: var(--surface-3);
    border: 1px solid var(--border);
    border-bottom-left-radius: 4px;
  }

  .typing span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--text-3);
    animation: typing-bounce 1.2s ease-in-out infinite;
  }

  .typing span:nth-child(2) {
    animation-delay: 0.15s;
  }

  .typing span:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes typing-bounce {
    0%,
    60%,
    100% {
      transform: translateY(0);
      opacity: 0.5;
    }
    30% {
      transform: translateY(-4px);
      opacity: 1;
    }
  }

  .chat-quick {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 10px 16px;
    border-top: 1px solid var(--border);
  }

  .chat-quick button {
    font-size: 12.5px;
    color: var(--text-2);
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    transition:
      color var(--dur-fast) ease,
      border-color var(--dur-fast) ease;
  }

  .chat-quick button:hover {
    color: var(--accent);
    border-color: var(--accent-line);
  }

  .chat-form {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
    border-top: 1px solid var(--border);
    background: var(--surface);
  }

  .chat-input {
    flex: 1;
    min-width: 0;
    height: 42px;
    padding: 0 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-strong);
    background: var(--bg);
    color: var(--text);
    font-size: 14px;
    font-family: inherit;
    outline: none;
    transition: border-color var(--dur-fast) ease;
  }

  .chat-input:focus {
    border-color: var(--accent-line);
  }

  .chat-input::placeholder {
    color: var(--text-3);
  }

  .chat-send {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    transition:
      background-color var(--dur-fast) ease,
      transform var(--dur-fast) ease;
  }

  .chat-send:hover {
    background: var(--accent-hover);
  }

  .chat-send:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 640px) {
    .chat-root {
      right: 16px;
      bottom: 16px;
    }

    .chat-fab-label {
      display: none;
    }

    .chat-fab {
      padding: 6px;
      width: 56px;
      height: 56px;
      justify-content: center;
    }

    .chat-panel {
      position: fixed;
      right: 12px;
      left: 12px;
      bottom: 12px;
      width: auto;
      height: 560px;
      max-height: calc(100vh - 40px);
      border-radius: var(--radius-l);
      transform-origin: bottom center;
    }

    @supports (height: 1dvh) {
      .chat-panel {
        height: min(560px, 82dvh);
      }
    }
  }
</style>
