---
import { nav, site } from '../data/site';
import { BASE_URL } from '../lib/base';
import CowCat from './CowCat.astro';

const basePath = BASE_URL === '/' ? '' : BASE_URL.replace(/\/+$/, '');
const rawPath = Astro.url.pathname;
const pathname = rawPath.startsWith(basePath) && basePath ? rawPath.slice(basePath.length) || '/' : rawPath;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href + '/');
---

<header class="site-header" id="site-header">
  <div class="container header-inner">
    <a class="brand" href={BASE_URL} aria-label="Tony Zhao · 返回首页">
      <span class="brand-mark"><CowCat /></span>
      <span>Tony Zhao</span>
    </a>

    <nav class="nav" aria-label="主导航">
      {
        nav.map((item) => (
          <a href={`${BASE_URL}${item.href.slice(1)}`} aria-current={isActive(item.href) ? 'page' : undefined} class:list={{ 'is-active': isActive(item.href) }}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <button
      class="menu-btn"
      id="menu-btn"
      aria-label="打开菜单"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <path class="icon-burger" d="M4 7h16M4 12h16M4 17h16" />
        <path class="icon-close" d="M6 6l12 12M18 6L6 18" style="display:none" />
      </svg>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <nav aria-label="移动端导航">
    {
      nav.map((item) => (
        <a href={`${BASE_URL}${item.href.slice(1)}`} aria-current={isActive(item.href) ? 'page' : undefined} class:list={{ 'is-active': isActive(item.href) }}>
          {item.label}
        </a>
      ))
    }
  </nav>
  <div class="mobile-menu-foot">
    <a href={`mailto:${site.email}`}>{site.email}</a>
    <span>{site.location}</span>
  </div>
</div>

<script>
  import { initNav } from '../scripts/nav';
  initNav();
</script>
