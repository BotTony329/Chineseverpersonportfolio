---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<ul class="olist">
  {
    items.map((item) => (
      <li class="olist-item">
        <svg class="olist-check" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 12.5 9.5 18 20 6.5" />
        </svg>
        <span>{item}</span>
      </li>
    ))
  }
</ul>

<style>
  .olist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .olist-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 15px;
    color: var(--text-2);
  }

  .olist-check {
    flex-shrink: 0;
    margin-top: 4px;
    color: var(--success);
  }
</style>
