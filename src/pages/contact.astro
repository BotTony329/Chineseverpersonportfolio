---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import SectionTitle from '../components/SectionTitle.astro';

const collaboration = ['企业数字化项目', 'Business Analysis', '产品设计合作', 'AI 产品与 SaaS', '创业合作'];
---

<Base
  title="联系"
  description={`联系 Tony Zhao：${site.email}。合作方向包括企业数字化项目、Business Analysis、产品设计合作、AI 产品与 SaaS、创业合作。`}
  path="/contact"
>
  <section class="page-head">
    <div class="container">
      <p class="eyebrow reveal">Contact</p>
      <h1 class="reveal" style="--rd:.06s">联系</h1>
      <p class="lead page-intro reveal" style="--rd:.12s">
        无论是企业数字化项目、BA / 产品合作，还是 AI 产品想法，都欢迎联系。
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionTitle index="01" label="联系方式" title="直接联系我" />

      <div class="contact-grid">
        <a class="ct-card card card--hover reveal" href={`mailto:${site.email}`}>
          <svg class="ct-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" />
          </svg>
          <span class="ct-label">邮箱</span>
          <span class="ct-value">{site.email}</span>
          <span class="ct-hint">发邮件给我 ↗</span>
        </a>

        <a class="ct-card card card--hover reveal" href={site.linkedin} target="_blank" rel="noopener noreferrer" style="--rd:.07s">
          <svg class="ct-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="3" />
            <path d="M7 10v7M7 7v.01M11.5 17v-4a2.5 2.5 0 0 1 5 0v4M11.5 17v-7" />
          </svg>
          <span class="ct-label">LinkedIn</span>
          <span class="ct-value">Tony Zhao</span>
          <span class="ct-hint">查看主页 ↗</span>
        </a>

        <div class="ct-card card reveal" style="--rd:.14s">
          <svg class="ct-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 3c2.5 2.4 4 5.6 4 9s-1.5 6.6-4 9c-2.5-2.4-4-5.6-4-9s1.5-6.6 4-9Z" />
            <path d="M3 12h18" />
          </svg>
          <span class="ct-label">所在地</span>
          <span class="ct-value">{site.location}</span>
          <span class="ct-hint">支持远程协作</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionTitle index="02" label="合作方向" title="我可以参与的角色" />
      <div class="reveal">
        <div class="coop-chips">
          {collaboration.map((c) => (
            <span class="chip chip--accent coop-chip">{c}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="ai-tip card reveal">
        <div class="ai-tip-text">
          <h2>先问问我的 AI 助手</h2>
          <p class="lead">
            关于我的项目、能力与经历，AI 助手可以基于 Portfolio 内容先回答你。
          </p>
        </div>
        <button class="btn btn-primary ai-tip-btn" type="button" id="open-chat">
          问问我的 AI 助手
        </button>
      </div>
    </div>
  </section>
</Base>

<script>
  import { initReveal } from '../scripts/reveal';
  initReveal();

  document.getElementById('open-chat')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('chat:open'));
  });
</script>

<style>
  .page-head {
    padding-block: clamp(48px, 8vh, 88px) var(--sp-5);
  }

  .page-intro {
    max-width: 640px;
    margin-top: 18px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .ct-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 26px;
    color: inherit;
  }

  .ct-card:hover {
    color: inherit;
  }

  .ct-icon {
    color: var(--accent);
    margin-bottom: 8px;
  }

  .ct-label {
    font-size: var(--fs-tiny);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .ct-value {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--text);
    word-break: break-all;
  }

  .ct-hint {
    font-size: var(--fs-tiny);
    color: var(--accent);
    margin-top: 4px;
  }

  .coop-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .coop-chip {
    padding: 12px 22px;
    font-size: 15px;
  }

  .ai-tip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding: 36px;
    background:
      radial-gradient(480px 240px at 85% -30%, rgba(59, 130, 246, 0.14), transparent 70%),
      var(--surface);
  }

  .ai-tip-text {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ai-tip-text h2 {
    font-size: 1.4rem;
  }

  .ai-tip-btn {
    flex-shrink: 0;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .ai-tip {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
