---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { projectGroups, archiveMinis } from '../../data/projects';
import { getProject } from '../../lib/projects';
import SectionTitle from '../../components/SectionTitle.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import SideProjectsWall from '../../components/SideProjectsWall.astro';
import CTABand from '../../components/CTABand.astro';

const all = projectGroups.flatMap((g) => g.slugs.map(getProject));
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Tony Zhao 项目案例',
    itemListElement: all.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: p?.title,
      url: new URL(`/projects/${p?.slug}`, site.url).href,
    })),
  },
];
---

<Base
  title="项目"
  description="Tony Zhao 的项目案例：5 个核心完整 Case Studies（企业物流 SaaS、AI 教师成长平台、MART-GPT、市场进入与数字化转型、产品模块上线）与 3 个简版 UX / Product Case Studies。"
  path="/projects"
  jsonLd={jsonLd}
>
  <section class="page-head">
    <div class="container">
      <p class="eyebrow reveal">Projects</p>
      <h1 class="reveal" style="--rd:.06s">项目</h1>
      <p class="lead page-intro reveal" style="--rd:.12s">
        5 个核心完整案例 + 3 个简版 UX / Product 案例，从企业 SaaS 交付、数字化转型方案，到独立 AI 产品。
      </p>
    </div>
  </section>

  {
    projectGroups.map((group, gi) => {
      const items = group.slugs.map(getProject);
      return (
        <section class="section">
          <div class="container">
            <SectionTitle
              index={String(gi + 1).padStart(2, '0')}
              title={group.title}
              desc={group.desc}
            />
            <div class="pgrid">
              {
                items.map((p, i) =>
                  p ? (
                    <div class="reveal" style={`--rd:${(i % 3) * 0.07}s`}>
                      <ProjectCard project={p} />
                    </div>
                  ) : null
                )
              }
            </div>

            {group.id === 'ux' && (
              <div class="mini-wrap">
                <h3 class="mini-heading">更多项目 · 简览</h3>
                <div class="mini-grid">
                  {
                    archiveMinis.map((m, i) => (
                      <div class="mini card reveal" style={`--rd:${(i % 3) * 0.06}s`}>
                        <div class="mini-top">
                          <span class="mini-name">{m.name}</span>
                          {m.status && <StatusBadge status={m.status} />}
                        </div>
                        <p class="mini-en">{m.nameEn}</p>
                        <p class="mini-desc">{m.desc}</p>
                        <div class="mini-tags">
                          {m.tags.map((t) => (
                            <span class="chip">{t}</span>
                          ))}
                        </div>
                      </div>
                    ))
                  }
                </div>
              </div>
            )}
          </div>
        </section>
      );
    })
  }

  <!-- 独立实践 -->
  <section class="section">
    <div class="container">
      <SectionTitle
        index="03"
        label="独立实践"
        title="Side Projects"
        desc="以下是我在工作之外持续实验的方向——用真实产品验证想法。"
      />
      <div class="reveal">
        <SideProjectsWall />
      </div>
    </div>
  </section>

  <div class="container">
    <CTABand
      title="想深入了解某个项目？"
      desc="欢迎直接联系我，进一步交流项目细节与合作可能。"
      primary={{ label: '联系我', href: '/contact' }}
      secondary={{ label: '回到首页', href: '/' }}
    />
  </div>
</Base>

<script>
  import { initReveal } from '../../scripts/reveal';
  initReveal();
</script>

<style>
  .page-head {
    padding-block: clamp(48px, 8vh, 88px) var(--sp-5);
  }

  .page-intro {
    max-width: 640px;
    margin-top: 18px;
  }

  .pgrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .mini-wrap {
    margin-top: var(--sp-5);
  }

  .mini-heading {
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-3);
    margin-bottom: 16px;
  }

  .mini-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .mini {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
  }

  .mini-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .mini-name {
    font-weight: 600;
    color: var(--text);
  }

  .mini-en {
    font-size: 12px;
    color: var(--text-3);
    margin-top: -4px;
  }

  .mini-desc {
    font-size: 14px;
    color: var(--text-2);
    flex-grow: 1;
  }

  .mini-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }

  @media (max-width: 1024px) {
    .pgrid,
    .mini-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .pgrid,
    .mini-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
